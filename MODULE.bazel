module(
    name = "bazel_quickstart",
)

bazel_dep(
    name = "platforms",
    version = "0.0.11",
)
bazel_dep(
    name = "bazel_skylib",
    version = "1.7.1",
)
bazel_dep(
    name = "rules_shell",
    version = "0.4.0",
)
bazel_dep(
    name = "rules_multirun",
    version = "0.11.0",
)

bazel_dep(
    name = "buildifier_prebuilt",
    version = "8.0.3",
    dev_dependency = True,
)

###############################################################################
# C++ and Cross-compilation Toolchains
###############################################################################
bazel_dep(name = "toolchains_llvm", version = "1.4.0")
bazel_dep(name = "toolchains_musl", version = "0.1.27")

# Configure LLVM toolchain for glibc targets
llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")
llvm.toolchain(
    llvm_version = "20.1.1",
    # Let toolchains_llvm handle sysroots automatically
)

use_repo(llvm, "llvm_toolchain")
use_repo(llvm, "llvm_toolchain_llvm")

# Configure musl toolchain for musl targets
musl = use_extension("@toolchains_musl//musl:extensions.bzl", "musl")
musl.toolchain()

# Register toolchains - musl first for musl targets, then LLVM for glibc targets
register_toolchains(
    "@toolchains_musl//:all",
    "@llvm_toolchain//:all",
)

###############################################################################
# Rust
###############################################################################
bazel_dep(name = "rules_rust", version = "0.60.0")

# Rust toolchain
RUST_EDITION = "2021"

RUST_VERSION = "1.86.0"

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = RUST_EDITION,
    versions = [RUST_VERSION],
    extra_target_triples = [
        "aarch64-unknown-linux-gnu",
        "aarch64-unknown-linux-musl",
        "x86_64-unknown-linux-gnu",
        "x86_64-unknown-linux-musl",
    ],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

crate = use_extension(
    "@rules_rust//crate_universe:extensions.bzl",
    "crate",
)
crate.from_cargo(
    name = "crates_io",
    cargo_lockfile = "//:Cargo.lock",
    isolated = False,
    manifests = ["//:Cargo.toml"],
)
use_repo(crate, "crates_io")
